{
    "sql": "SELECT COUNT(extendedprice) AS cnt_res FROM (SELECT p.partkey * 0 AS mask, l.extendedprice FROM part AS p JOIN (SELECT l2.partkey, AVG(l2.quantity) AS threshold FROM lineitem AS l2 GROUP BY l2.partkey) AS aq ON p.partkey = aq.partkey JOIN lineitem AS l ON l.partkey = p.partkey WHERE p.brand = 2 AND l.quantity < aq.threshold) AS t GROUP BY mask;",
